<%
me = Employees[Work_Email == zoho.loginuser];
isHR = false;
isManager = false;
scopeLabel = "My activity";
if(me.count() > 0)
{
  isHR = me.Department == "Human Resources";
  isManager = Employees[Manager == me.ID].count() > 0;
}
if(isHR)
{
  scopeLabel = "Organization-wide activity";
  scoped = Leave_Requests[ID != 0] sort by Start_Date;
}
else if(isManager)
{
  scopeLabel = "Assigned-team activity";
  scoped = Leave_Requests[Employee.Manager == me.ID] sort by Start_Date;
}
else
{
  scoped = Leave_Requests[Employee == me.ID] sort by Start_Date;
}
submitted = 0;
pending = 0;
completed = 0;
rejected = 0;
for each request_record in scoped
{
  if(request_record.Status == "Submitted") { submitted = submitted + 1; }
  else if(request_record.Status == "Pending HR") { pending = pending + 1; }
  else if(request_record.Status == "Rejected") { rejected = rejected + 1; }
  else if(request_record.Status == "Completed" && request_record.Start_Date.getMonth() == zoho.currentdate.getMonth() && request_record.Start_Date.getYear() == zoho.currentdate.getYear()) { completed = completed + 1; }
}
total = submitted + pending + completed + rejected;
if(total == 0) { total = 1; }
a1 = submitted * 100 / total;
a2 = pending * 100 / total;
a3 = completed * 100 / total;
a4 = rejected * 100 / total;
upcoming = scoped;
balances = Leave_Balances[Employee == me.ID && Balance_Year == zoho.currentdate.getYear()];
%>
<style>
/* zcs-global: page utility subset used by this dashboard */
:root{--zcs-theme-brand-color:var(--zcs_brand_color);--zcs-white-color:#fff;--zcs-primary-text-color:var(--zcs_primary_text_color);--zcs-secondary-text-color:var(--zcs_secondary_text_color);--zcs-border-color:var(--zcs_tertiary_border_color)}*{box-sizing:border-box}.zcs-flex{display:flex}.zcs-inline-flex{display:inline-flex}.zcs-row{display:flex;flex-wrap:wrap}.zcs-direction-column{flex-direction:column}.zcs-align-items-center{align-items:center}.zcs-justify-space-between{justify-content:space-between}.zcs-justify-center{justify-content:center}.zcs-gap-8{gap:8px}.zcs-gap-12{gap:12px}.zcs-gap-16{gap:16px}.zcs-gap-24{gap:24px}.zcs-w-full{width:100%}.zcs-p-0{padding:0}.zcs-p-16{padding:16px}.zcs-p-20{padding:20px}.zcs-px-10{padding-left:10px;padding-right:10px}.zcs-px-12{padding-left:12px;padding-right:12px}.zcs-px-16{padding-left:16px;padding-right:16px}.zcs-py-2{padding-top:2px;padding-bottom:2px}.zcs-py-8{padding-top:8px;padding-bottom:8px}.zcs-m-0{margin:0}.zcs-font-12{font-size:12px}.zcs-font-14{font-size:14px}.zcs-font-15{font-size:15px}.zcs-font-18{font-size:18px}.zcs-font-24{font-size:24px}.zcs-font-30{font-size:30px}.zcs-font-normal{font-weight:400}.zcs-font-medium{font-weight:500}.zcs-font-semibold{font-weight:600}.zcs-color-primary{color:var(--zcs-primary-text-color)}.zcs-color-secondary{color:var(--zcs-secondary-text-color)}.zcs-rounded-sm{border-radius:4px}.zcs-rounded-md{border-radius:6px}.zcs-rounded-xl{border-radius:12px}.zcs-rounded-full{border-radius:100%}.zcs-card{background:var(--zcs-white-color);border:1px solid var(--zcs-border-color);border-radius:12px}.ld{padding:24px;background:var(--zcs-page-bg-color,#f5f7fa);color:var(--zcs-primary-text-color);font-family:inherit}.ld-header{margin-bottom:20px}.ld-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.ld-kpi{grid-column:span 3;padding:18px}.ld-kpi i{font-size:22px;color:var(--zcs_brand_color)}.ld-main{grid-column:span 8}.ld-side{grid-column:span 4}.ld-card{padding:20px}.ld-value{font-size:30px;font-weight:600;margin-top:10px}.ld-sub{color:var(--zcs-secondary-text-color);font-size:13px}.ld-balance{min-width:145px;padding:14px}.zcs-button{min-height:36px;background:var(--zcs_brand_color);color:var(--zcs_brand_foreground_color);padding:8px 16px;border-radius:6px}.zcs-table-wrapper{border:1px solid var(--zcs-border-color);overflow:auto}.zcs-table-wrapper table{border-collapse:collapse;width:100%}.zcs-table-wrapper th{background:#f9fafe}.zcs-table-wrapper th,.zcs-table-wrapper td{padding:10px 16px;text-align:left;border-top:1px solid var(--zcs-border-color);font-size:14px}.zcs-badge{color:#fff;border-radius:4px;padding:2px 10px}.zcs-badge-green{background:#179e6c}.zcs-badge-yellow{background:#faae13}.zcs-badge-red{background:#fe455d}.zcs-badge-blue{background:#2a6ffc}.zcs-quick-action-item{list-style:none;border:1px solid var(--zcs-border-color);border-radius:8px;padding:10px 12px}.zcs-quick-action-link{color:var(--zcs-primary-text-color)}.zcs-quick-action-item:hover{border-color:var(--zcs_brand_color)}.zcs-donut-chart{width:180px;height:180px;border-radius:50%;background:conic-gradient(#faae13 0 calc(var(--a1)*1%),#2a6ffc 0 calc((var(--a1) + var(--a2))*1%),#179e6c 0 calc((var(--a1) + var(--a2) + var(--a3))*1%),#fe455d 0);position:relative}.zcs-donut-chart:after{content:"";position:absolute;inset:34px;background:white;border-radius:50%}.donut-label{position:absolute;z-index:1;text-align:center}.legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block}@media(max-width:900px){.ld-kpi{grid-column:span 6}.ld-main,.ld-side{grid-column:span 12}}@media(max-width:560px){.ld{padding:14px}.ld-kpi{grid-column:span 12}}
</style>
<div class="ld">
  <div class="ld-header zcs-flex zcs-align-items-center zcs-justify-space-between zcs-gap-16">
    <div><h2 class="zcs-m-0">Leave dashboard</h2><div class="ld-sub"><%=scopeLabel%> for <%=zoho.loginuser%></div></div>
    <a class="zcs-button zcs-inline-flex zcs-align-items-center zcs-gap-8" href="#Form:Leave_Requests"><i class="zc-li-outline ui-1-edit-72"></i><span>Submit request</span></a>
  </div>
  <div class="ld-grid">
    <div class="ld-kpi zcs-card"><div class="zcs-flex zcs-justify-space-between"><span>Submitted</span><i class="zc-li-outline files-2-doc"></i></div><div class="ld-value"><%=submitted%></div><div class="ld-sub">Awaiting manager review</div></div>
    <div class="ld-kpi zcs-card"><div class="zcs-flex zcs-justify-space-between"><span>Pending HR</span><i class="zc-li-outline ui-2-time"></i></div><div class="ld-value"><%=pending%></div><div class="ld-sub">Balance confirmation needed</div></div>
    <div class="ld-kpi zcs-card"><div class="zcs-flex zcs-justify-space-between"><span>Completed this month</span><i class="zc-li-outline ui-1-check-circle-08"></i></div><div class="ld-value"><%=completed%></div><div class="ld-sub">Approved leave</div></div>
    <div class="ld-kpi zcs-card"><div class="zcs-flex zcs-justify-space-between"><span>Rejected</span><i class="zc-li-outline ui-1-circle-remove"></i></div><div class="ld-value"><%=rejected%></div><div class="ld-sub">Closed requests</div></div>
    <div class="ld-main zcs-card ld-card"><h3 class="zcs-m-0">Status distribution</h3><div class="zcs-flex zcs-align-items-center zcs-justify-center zcs-gap-24 zcs-p-20"><div class="zcs-donut-chart zcs-flex zcs-align-items-center zcs-justify-center" style="--a1:<%=a1%>;--a2:<%=a2%>;--a3:<%=a3%>;--a4:<%=a4%>"><div class="donut-label"><strong class="zcs-font-24"><%=submitted + pending + completed + rejected%></strong><br><span class="ld-sub">requests</span></div></div><div class="zcs-flex zcs-direction-column zcs-gap-12"><span><i class="legend-dot" style="background:#faae13"></i> Submitted: <strong><%=submitted%></strong></span><span><i class="legend-dot" style="background:#2a6ffc"></i> Pending HR: <strong><%=pending%></strong></span><span><i class="legend-dot" style="background:#179e6c"></i> Completed: <strong><%=completed%></strong></span><span><i class="legend-dot" style="background:#fe455d"></i> Rejected: <strong><%=rejected%></strong></span></div></div></div>
    <div class="ld-main zcs-card ld-card"><div class="zcs-flex zcs-justify-space-between zcs-align-items-center"><h3 class="zcs-m-0">Upcoming approved leave</h3><span class="zcs-badge zcs-badge-green">Completed</span></div><div class="zcs-table-wrapper zcs-rounded-sm" style="margin-top:14px"><table><thead><tr><th>Employee</th><th>Leave type</th><th>Dates</th><th>Days</th><th>Status</th></tr></thead><tbody><% rowCount = 0; for each r in upcoming { if(rowCount < 6) { rowCount = rowCount + 1; %><tr><td><%=r.Employee.Employee_Name%></td><td><%=r.Leave_Type.Leave_Type_Name%></td><td><%=r.Start_Date%> - <%=r.End_Date%></td><td><%=r.Requested_Days%></td><td><span class="zcs-badge zcs-badge-green">Completed</span></td></tr><% } } if(rowCount == 0) { %><tr><td colspan="5" class="ld-sub">No upcoming approved leave in your current view.</td></tr><% } %></tbody></table></div></div>
    <div class="ld-side zcs-card ld-card"><h3 class="zcs-m-0">My remaining balances</h3><div class="zcs-row zcs-gap-12" style="margin-top:14px"><% balanceCount = 0; for each b in balances { balanceCount = balanceCount + 1; %><div class="ld-balance zcs-card"><div class="ld-sub"><%=b.Leave_Type.Leave_Type_Name%></div><div class="zcs-font-24 zcs-font-semibold"><%=b.Remaining_Days%></div><div class="ld-sub">days remaining</div></div><% } if(balanceCount == 0) { %><div class="ld-sub">No current-year balance records are available.</div><% } %></div></div>
  </div>
</div>