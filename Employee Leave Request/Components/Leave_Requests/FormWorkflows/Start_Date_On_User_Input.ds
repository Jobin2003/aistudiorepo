Start_Date_On_User_Input as "Recalculate Requested Days from Start Date"
{
    type = form
    form = Leave_Requests
    record event = on add or edit

    on user input of Start_Date
    {
        actions
        {
            custom deluge script
            (
                input.Requested_Days = 0;
                if (input.Leave_Type != null && input.Start_Date != null && input.End_Date != null && input.End_Date >= input.Start_Date)
                {
                    leave_type_record = Leave_Types[ID == input.Leave_Type];
                    day_count = input.Start_Date.daysBetween(input.End_Date) + 1;
                    day_list = ".".leftpad(day_count - 1).toList("");
                    current_date = input.Start_Date;
                    days = 0;
                    for each day_item in day_list
                    {
                        if (leave_type_record.Count_Weekends == true || (current_date.getDayOfWeek() != 1 && current_date.getDayOfWeek() != 7))
                        {
                            days = days + 1;
                        }
                        current_date = current_date.addDay(1);
                    }
                    input.Requested_Days = days;
                }
            )
        }
    }
}
