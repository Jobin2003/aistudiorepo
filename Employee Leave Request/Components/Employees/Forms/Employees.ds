form Employees
{
    title
    {
        displayname = "Employees"
        on add = "Add Employee"
        on edit = "Edit Employee"
    }
    success message = "Employee saved successfully."

    Details
    (
        type = section
        displayname = "Employee Details"
        row = 1
        column = 0
    )
    Employee_ID
    (
        type = autonumber
        displayname = "Employee ID"
        start index = 1001
        row = 1
        column = 1
        width = medium
    )
    must have Employee_Name
    (
        type = name
        displayname = "Employee Name"
        prefix
        (
            type = prefix
            displayname = "Title"
            visibility = false
            value = {"Mr.", "Mrs.", "Ms.", "Dr."}
        )
        first_name
        (
            type = first_name
            displayname = "First Name"
        )
        last_name
        (
            type = last_name
            displayname = "Last Name"
        )
        suffix
        (
            type = suffix
            displayname = "Suffix"
            visibility = false
        )
        row = 1
        column = 1
        width = medium
    )
    must have unique Work_Email
    (
        type = email
        displayname = "Work Email"
        personal data = true
        row = 1
        column = 2
        width = medium
    )
    must have Department
    (
        type = picklist
        displayname = "Department"
        values = {"Human Resources", "Finance", "Sales", "Marketing", "Operations", "Engineering", "Customer Support", "Other"}
        row = 1
        column = 1
        width = medium
    )
    must have Job_Title
    (
        type = text
        displayname = "Job Title"
        row = 1
        column = 2
        width = medium
    )
    Manager
    (
        type = picklist
        displayname = "Manager"
        values = Employees.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    must have Employment_Status
    (
        type = picklist
        displayname = "Employment Status"
        values = {"Active", "Inactive"}
        initial value = "Active"
        row = 1
        column = 2
        width = medium
    )
    must have Hire_Date
    (
        type = date
        displayname = "Hire Date"
        row = 1
        column = 1
        width = medium
    )

    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Save Employee"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update Employee"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
