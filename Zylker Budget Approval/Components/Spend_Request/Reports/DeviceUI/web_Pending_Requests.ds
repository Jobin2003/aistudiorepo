report Pending_Requests
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Request_ID
                    Requester_Name
                    Department
                    Estimated_Cost
                    Approval_Tier
                    Status
                    SLA_Due_Date
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
            record
            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Request_ID
                    Requester_Name
                    Department
                    Estimated_Cost
                    Approval_Tier
                    Status
                    SLA_Due_Date
                    Priority
                    Item_Description
                    Submitted_Date
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Duplicate
                Delete
            )
        )
    )
}
