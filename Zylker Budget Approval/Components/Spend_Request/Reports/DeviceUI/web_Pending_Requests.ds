report Pending_Requests
{
    quickview
    (
        layout
        (
            type = -1
            datablock1
            (
                layout type = -1
                fields
                (
                    Request_ID
                    Requester_Name
                    Department
                    Item_Description
                    Estimated_Cost
                    Approval_Tier
                    Priority
                    SLA_Due_Date
                    "Approve"
                    "Hold"
                    "Reject"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Delete
            )
            record
            (
                Edit
                Delete
                "Approve"
                "Hold"
                "Reject"
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                View Record
                "Approve"
                "Hold"
                "Reject"
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                title = "Request Details"
                fields
                (
                    Request_ID
                    Requester_Name
                    Department
                    Item_Description
                    Estimated_Cost
                    Approval_Tier
                    Priority
                    Justification
                    Submitted_Date
                    SLA_Due_Date
                )
            )
            datablock2
            (
                layout type = -2
                title = "Approval Action"
                fields
                (
                    Status
                    "Approve"
                    "Hold"
                    "Reject"
                )
            )
        )
        menu
        (
            header
            (
                Edit
                Delete
            )
        )
    )
}
