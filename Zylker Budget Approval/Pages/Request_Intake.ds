<page linkname="Request_Intake" displayname="Request Intake"/>
<content>
<zml>
  <layout>
    <row>
      <column width='100%'>
        <dsp id='ri_form_info' elementName='Form_Card'>
          <![CDATA[htmlpage ri_form_info()
             content
             <%{%>
                 <file name:Form_Card.dshtml/>
             <%}%>
         ]]>
        </dsp>
        <form elementName='Spend_Request_Form'
              appLinkName='thisapp'
              linkName='Spend_Request'
              heightType='auto'
              zc_Header='false'
              urlType='page'
              urlAppLinkName='thisapp'
              zc_NextUrl='#Page:Approvals'
              zc_OpenUrlIn='same window'
              zc_SuccMsg='Your spend request has been submitted successfully.'
              zc_SubmitVal='Submit Request'
              zc_ResetVal='Clear' />
      </column>
    </row>
  </layout>
</zml>
</content>
