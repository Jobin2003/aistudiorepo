<link href='https://fonts.googleapis.com/css2?family=Lato:wght@400;600;700&display=swap' rel='stylesheet'>
<style>
  .ri-wrap {
    padding: 24px 28px 16px 28px;
    background: #F8FAFC;
    font-family: 'Lato', sans-serif;
    box-sizing: border-box;
  }
  .ri-page-title {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }
  .ri-page-sub {
    font-size: 13px;
    color: #6B7280;
    margin: 0 0 20px 0;
  }
  .ri-context-card {
    background: #FFFFFF;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    padding: 20px 24px;
    max-width: 920px;
    margin-bottom: 4px;
  }
  .ri-info-strip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }
  .ri-info-text {
    font-size: 13px;
    color: #1D4ED8;
    font-style: italic;
    line-height: 1.5;
    margin: 0;
    font-family: 'Lato', sans-serif;
  }
  .ri-divider {
    border: none;
    border-top: 1px solid #E5E7EB;
    margin: 0 0 16px 0;
  }
  .ri-tier-lbl {
    font-size: 11px;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 700;
    display: block;
    margin-bottom: 10px;
    font-family: 'Lato', sans-serif;
  }
  .ri-tier-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .ri-badge {
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    display: inline-block;
    font-family: 'Lato', sans-serif;
    line-height: 1.4;
  }
  .ri-auto  { background: #DCFCE7; color: #16AD78; }
  .ri-two   { background: #FEF9C3; color: #D97706; }
  .ri-three { background: #EFF6FF; color: #2563EB; }
</style>

<div class="ri-wrap">
  <h1 class="ri-page-title">New Spend Request</h1>
  <p class="ri-page-sub">Atlas Precision Manufacturing Inc. &middot; Plant 3, Ohio, USA</p>

  <div class="ri-context-card">
    <div class="ri-info-strip">
      <i class="zc-li-outline ui-1-info-circle" style="font-size:16px;color:#2563EB;flex-shrink:0;margin-top:2px;"></i>
      <p class="ri-info-text">Requester ID, Reporting Manager, and Department Head auto-resolve when your name and department match the Employee Directory. Item cost auto-fills from the Request Catalog when you select an item. The Approval Tier is calculated automatically from the cost entered.</p>
    </div>
    <hr class="ri-divider">
    <span class="ri-tier-lbl">Approval Tier Thresholds</span>
    <div class="ri-tier-row">
      <span class="ri-badge ri-auto">Auto - Up to $1,000</span>
      <span class="ri-badge ri-two">2-Person - $1,001 to $50,000</span>
      <span class="ri-badge ri-three">3-Person - $50,001 and above</span>
    </div>
  </div>
</div>
