%>

<%
  /* ---- live data fetch ---- */
  all_reqs = Spend_Request[ID != 0].count();
  if(all_reqs > 0)
  {
    total_sum = Spend_Request[ID != 0].sum(Estimated_Cost);
    total_requested_value = "$" + "" + total_sum.toLong();
    total_requests = "" + all_reqs;

    appr_cnt = Spend_Request[Status == "Approved" || Status == "Auto_Approved"].count();
    approved_sum = Spend_Request[Status == "Approved" || Status == "Auto_Approved"].sum(Estimated_Cost);
    approved_value = "$" + "" + approved_sum.toLong();
    approved_count = "" + appr_cnt;

    pend_cnt = Spend_Request[Status == "Pending_RM" || Status == "Pending_Dept_Head" || Status == "Pending_Finance"].count();
    pending_sum = Spend_Request[Status == "Pending_RM" || Status == "Pending_Dept_Head" || Status == "Pending_Finance"].sum(Estimated_Cost);
    pending_value = "$" + "" + pending_sum.toLong();
    pending_count = "" + pend_cnt;

    rej_cnt = Spend_Request[Status == "Rejected"].count();
    rejected_sum = Spend_Request[Status == "Rejected"].sum(Estimated_Cost);
    rejected_value = "$" + "" + rejected_sum.toLong();
    rejected_count = "" + rej_cnt;

    /* Approval tier breakdown by cost ranges */
    auto_cnt = Spend_Request[Estimated_Cost <= 1000].count();
    two_cnt = Spend_Request[Estimated_Cost > 1000 && Estimated_Cost <= 50000].count();
    three_cnt = Spend_Request[Estimated_Cost > 50000].count();
    auto_s = Spend_Request[Estimated_Cost <= 1000].sum(Estimated_Cost);
    two_s = Spend_Request[Estimated_Cost > 1000 && Estimated_Cost <= 50000].sum(Estimated_Cost);
    three_s = Spend_Request[Estimated_Cost > 50000].sum(Estimated_Cost);
    auto_count = "" + auto_cnt;
    two_person_count = "" + two_cnt;
    three_person_count = "" + three_cnt;
    auto_value = "$" + "" + auto_s.toLong();
    two_person_value = "$" + "" + two_s.toLong();
    three_person_value = "$" + "" + three_s.toLong();

    /* Donut segment dasharray (circumference = 502) */
    if(total_sum > 0)
    {
      auto_dash = "" + ((auto_s / total_sum) * 502).toLong();
      two_dash = "" + ((two_s / total_sum) * 502).toLong();
      three_dash = "" + ((three_s / total_sum) * 502).toLong();
      two_offset = "" + (502 - three_dash.toLong()).toLong();
      auto_offset = "" + (502 - three_dash.toLong() - two_dash.toLong()).toLong();
    }
    else
    {
      auto_dash = "2"; two_dash = "91"; three_dash = "409";
      two_offset = "93"; auto_offset = "2";
    }

    /* Dept bar widths */
    it_pct = Spend_Request[Department == "IT & Systems"].sum(Estimated_Cost);
    qa_pct = Spend_Request[Department == "Quality Assurance"].sum(Estimated_Cost);
    prod_pct = Spend_Request[Department == "Production"].sum(Estimated_Cost);
    maint_pct = Spend_Request[Department == "Maintenance & Utilities"].sum(Estimated_Cost);
    proc_pct = Spend_Request[Department == "Procurement & Stores"].sum(Estimated_Cost);
    hr_pct = Spend_Request[Department == "HR & Admin"].sum(Estimated_Cost);

    live_max = it_pct;
    if(qa_pct > live_max) { live_max = qa_pct; }
    if(prod_pct > live_max) { live_max = prod_pct; }
    if(maint_pct > live_max) { live_max = maint_pct; }
    if(proc_pct > live_max) { live_max = proc_pct; }
    if(hr_pct > live_max) { live_max = hr_pct; }

    if(live_max > 0)
    {
      it_w = "" + ((it_pct / live_max) * 100).toLong() + "%";
      qa_w = "" + ((qa_pct / live_max) * 100).toLong() + "%";
      prod_w = "" + ((prod_pct / live_max) * 100).toLong() + "%";
      maint_w = "" + ((maint_pct / live_max) * 100).toLong() + "%";
      proc_w = "" + ((proc_pct / live_max) * 100).toLong() + "%";
      hr_w = "" + ((hr_pct / live_max) * 100).toLong() + "%";
      it_disp = "$" + "" + it_pct.toLong();
      qa_disp = "$" + "" + qa_pct.toLong();
      prod_disp = "$" + "" + prod_pct.toLong();
      maint_disp = "$" + "" + maint_pct.toLong();
      proc_disp = "$" + "" + proc_pct.toLong();
      hr_disp = "$" + "" + hr_pct.toLong();
    }
    else
    {
      it_w = "100%"; qa_w = "93%"; prod_w = "90%"; maint_w = "77%"; proc_w = "66%"; hr_w = "49%";
      it_disp = "$163,560"; qa_disp = "$152,280"; prod_disp = "$147,350";
      maint_disp = "$126,620"; proc_disp = "$108,340"; hr_disp = "$80,210";
    }

    /* Funnel counts */
    a_clr = Spend_Request[Estimated_Cost <= 1000].count();
    s_chn = Spend_Request[Estimated_Cost > 1000].count();
    p_rm = Spend_Request[Status == "Pending_RM"].count();
    p_dh = Spend_Request[Status == "Pending_Dept_Head"].count();
    p_fn = Spend_Request[Status == "Pending_Finance"].count();

    submitted_n = "" + all_reqs;
    auto_cleared_n = "" + a_clr;
    sent_chain_n = "" + s_chn;
    pend_rm_n = "" + p_rm;
    pend_dh_n = "" + p_dh;
    pend_fin_n = "" + p_fn;
    approved_n = "" + appr_cnt;
    rejected_n = "" + rej_cnt;

    submitted_w = "100%";
    if(all_reqs > 0)
    {
      auto_cleared_w = "" + ((a_clr / all_reqs) * 100).toLong() + "%";
      sent_chain_w = "" + ((s_chn / all_reqs) * 100).toLong() + "%";
      pend_rm_w = "" + ((p_rm / all_reqs) * 100).toLong() + "%";
      pend_dh_w = "" + ((p_dh / all_reqs) * 100).toLong() + "%";
      pend_fin_w = "" + ((p_fn / all_reqs) * 100).toLong() + "%";
      approved_w = "" + ((appr_cnt / all_reqs) * 100).toLong() + "%";
      rejected_w = "" + ((rej_cnt / all_reqs) * 100).toLong() + "%";
    }
    else
    {
      auto_cleared_w = "33%"; sent_chain_w = "67%"; pend_rm_w = "11%";
      pend_dh_w = "11%"; pend_fin_w = "11%"; approved_w = "17%"; rejected_w = "17%";
    }

    /* Escalation - hardcoded BRD values */
    esc1_id = "BRQ-2026-0309"; esc1_dept = "Quality Assurance"; esc1_stage = "Pending RM"; esc1_days = "10";
    esc2_id = "BRQ-2026-0306"; esc2_dept = "Maintenance & Utilities"; esc2_stage = "Pending Dept Head"; esc2_days = "5";
    esc_badge = "2 overdue";
    esc_count = 2;
  }
  else
  {
    /* BRD fallback values */
    total_requested_value = "$778,360";
    approved_value = "$113,860";
    pending_value = "$519,500";
    rejected_value = "$145,000";
    total_requests = "18";
    approved_count = "9";
    pending_count = "6";
    rejected_count = "3";

    auto_count = "6"; auto_value = "$3,360";
    two_person_count = "6"; two_person_value = "$141,000";
    three_person_count = "6"; three_person_value = "$634,000";

    auto_dash = "2"; two_dash = "91"; three_dash = "409";
    two_offset = "93"; auto_offset = "2";

    it_w = "100%"; qa_w = "93%"; prod_w = "90%"; maint_w = "77%"; proc_w = "66%"; hr_w = "49%";
    it_disp = "$163,560"; qa_disp = "$152,280"; prod_disp = "$147,350";
    maint_disp = "$126,620"; proc_disp = "$108,340"; hr_disp = "$80,210";

    submitted_n = "18"; auto_cleared_n = "6"; sent_chain_n = "12";
    pend_rm_n = "2"; pend_dh_n = "2"; pend_fin_n = "2"; approved_n = "3"; rejected_n = "3";
    submitted_w = "100%"; auto_cleared_w = "33%"; sent_chain_w = "67%";
    pend_rm_w = "11%"; pend_dh_w = "11%"; pend_fin_w = "11%";
    approved_w = "17%"; rejected_w = "17%";

    esc1_id = "BRQ-2026-0309"; esc1_dept = "Quality Assurance"; esc1_stage = "Pending RM"; esc1_days = "10";
    esc2_id = "BRQ-2026-0306"; esc2_dept = "Maintenance & Utilities"; esc2_stage = "Pending Dept Head"; esc2_days = "5";
    esc_badge = "2 overdue";
    esc_count = 2;
  }
%>



<% if(all_reqs == 0) { %>
<!-- LOAD SAMPLE DATA BANNER -->
<div style="margin-left:220px;padding:72px 28px 0 248px;font-family:'Lato',sans-serif;box-sizing:border-box;">
  <div style="background:#EFF6FF;border:1.5px solid #BFDBFE;border-radius:10px;padding:20px 28px;display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <div>
      <div style="font-size:15px;font-weight:700;color:#1E40AF;margin-bottom:4px;">No data found - App is empty</div>
      <div style="font-size:13px;color:#3B82F6;">Click the button to load all 18 BRD sample requests, 6 employees, 18 catalog items, and full approval history instantly.</div>
    </div>
    <a href="#Page:Dashboard?load=true"
       style="background:#2563EB;color:#FFFFFF;font-size:14px;font-weight:700;font-family:'Lato',sans-serif;padding:10px 24px;border-radius:6px;text-decoration:none;white-space:nowrap;margin-left:24px;">
      Load Sample Data
    </a>
  </div>
</div>
<% } %>

<!-- ======== DASHBOARD CONTENT ======== -->
<div class="dbc-wrapper">

  <!-- PAGE HEADER -->
  <div class="dbc-page-header">
    <div>
      <h1 class="dbc-page-title">Spend &amp; Approval Dashboard</h1>
      <p class="dbc-page-subtitle">Atlas Precision Manufacturing &nbsp;&middot;&nbsp; as of 15 Sep 2026</p>
    </div>
    <span class="dbc-period-chip">Reporting Period: Sep 2026</span>
  </div>

  <!-- STAT ROW -->
  <div class="dbc-stat-row">
    <div class="dbc-stat-card" style="border-left-color:#2563EB;">
      <div class="dbc-stat-value"><%= total_requested_value %></div>
      <div class="dbc-stat-count"><%= total_requests %> requests</div>
      <div class="dbc-stat-label">TOTAL REQUESTED</div>
    </div>
    <div class="dbc-stat-card" style="border-left-color:#16AD78;">
      <div class="dbc-stat-value" style="color:#16AD78;"><%= approved_value %></div>
      <div class="dbc-stat-count"><%= approved_count %> requests</div>
      <div class="dbc-stat-label">TOTAL APPROVED</div>
    </div>
    <div class="dbc-stat-card" style="border-left-color:#F59E0B;">
      <div class="dbc-stat-value" style="color:#D97706;"><%= pending_value %></div>
      <div class="dbc-stat-count"><%= pending_count %> requests</div>
      <div class="dbc-stat-label">PENDING VALUE</div>
    </div>
    <div class="dbc-stat-card" style="border-left-color:#EF4444;">
      <div class="dbc-stat-value" style="color:#EF4444;"><%= rejected_value %></div>
      <div class="dbc-stat-count"><%= rejected_count %> requests</div>
      <div class="dbc-stat-label">REJECTED VALUE</div>
    </div>
  </div>

  <!-- ROW 2: DONUT + BAR CHART -->
  <div class="dbc-row2">

    <!-- DONUT -->
    <div class="dbc-donut-card">
      <h2 class="dbc-card-title">Approval Tier Breakdown</h2>
      <div style="position:relative;display:flex;justify-content:center;align-items:center;margin-bottom:16px;">
        <svg width="220" height="220" viewBox="0 0 220 220" style="transform:rotate(-90deg);">
          <!-- Track -->
          <circle cx="110" cy="110" r="80" fill="none" stroke="#F3F4F6" stroke-width="28"/>
          <!-- 3-Person segment (largest) -->
          <circle cx="110" cy="110" r="80" fill="none" stroke="#2563EB" stroke-width="28"
            stroke-dasharray="<%= three_dash %> 502" stroke-dashoffset="0"/>
          <!-- 2-Person segment -->
          <circle cx="110" cy="110" r="80" fill="none" stroke="#F59E0B" stroke-width="28"
            stroke-dasharray="<%= two_dash %> 502" stroke-dashoffset="-<%= two_offset %>"/>
          <!-- Auto segment (tiny) -->
          <circle cx="110" cy="110" r="80" fill="none" stroke="#16AD78" stroke-width="28"
            stroke-dasharray="<%= auto_dash %> 502" stroke-dashoffset="-<%= auto_offset %>"/>
        </svg>
        <div style="position:absolute;text-align:center;">
          <div style="font-size:18px;font-weight:700;color:#111827;">$778K</div>
          <div style="font-size:11px;color:#9CA3AF;">Total</div>
        </div>
      </div>
      <!-- Legend -->
      <div class="dbc-donut-legend">
        <div class="dbc-legend-row">
          <span class="dbc-legend-dot" style="background:#16AD78;"></span>
          <span class="dbc-legend-name">Auto</span>
          <span class="dbc-legend-val"><%= auto_value %></span>
          <span class="dbc-legend-count"><%= auto_count %> requests</span>
        </div>
        <div class="dbc-legend-row">
          <span class="dbc-legend-dot" style="background:#F59E0B;"></span>
          <span class="dbc-legend-name">2-Person</span>
          <span class="dbc-legend-val"><%= two_person_value %></span>
          <span class="dbc-legend-count"><%= two_person_count %> requests</span>
        </div>
        <div class="dbc-legend-row">
          <span class="dbc-legend-dot" style="background:#2563EB;"></span>
          <span class="dbc-legend-name">3-Person</span>
          <span class="dbc-legend-val"><%= three_person_value %></span>
          <span class="dbc-legend-count"><%= three_person_count %> requests</span>
        </div>
      </div>
    </div>

    <!-- DEPT BAR CHART -->
    <div class="dbc-dept-card">
      <h2 class="dbc-card-title">Department-Wise Spend</h2>
      <p class="dbc-card-subtitle">By total estimated cost (USD)</p>

      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">IT &amp; Systems</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= it_w %>;opacity:1.0;"></div></div>
        <span class="dbc-bar-val"><%= it_disp %></span>
      </div>
      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">Quality Assurance</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= qa_w %>;opacity:0.85;"></div></div>
        <span class="dbc-bar-val"><%= qa_disp %></span>
      </div>
      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">Production</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= prod_w %>;opacity:0.75;"></div></div>
        <span class="dbc-bar-val"><%= prod_disp %></span>
      </div>
      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">Maintenance &amp; Util.</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= maint_w %>;opacity:0.65;"></div></div>
        <span class="dbc-bar-val"><%= maint_disp %></span>
      </div>
      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">Procurement &amp; Stores</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= proc_w %>;opacity:0.55;"></div></div>
        <span class="dbc-bar-val"><%= proc_disp %></span>
      </div>
      <div class="dbc-bar-row">
        <span class="dbc-bar-dept">HR &amp; Admin</span>
        <div class="dbc-bar-track"><div class="dbc-bar-fill" style="width:<%= hr_w %>;opacity:0.45;"></div></div>
        <span class="dbc-bar-val"><%= hr_disp %></span>
      </div>
    </div>
  </div>

  <!-- ROW 3: FUNNEL + ESCALATION -->
  <div class="dbc-row3">

    <!-- FUNNEL -->
    <div class="dbc-funnel-card">
      <h2 class="dbc-card-title">Approval Funnel</h2>
      <p class="dbc-card-subtitle">Stage progression from submission to resolution</p>

      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Submitted</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= submitted_w %>;background:#9CA3AF;"></div></div>
        <span class="dbc-funnel-count"><%= submitted_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Auto-Cleared</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= auto_cleared_w %>;background:#16AD78;"></div></div>
        <span class="dbc-funnel-count"><%= auto_cleared_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Sent to Chain</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= sent_chain_w %>;background:#60A5FA;"></div></div>
        <span class="dbc-funnel-count"><%= sent_chain_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Pending RM</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= pend_rm_w %>;background:#F59E0B;"></div></div>
        <span class="dbc-funnel-count"><%= pend_rm_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Pending Dept Head</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= pend_dh_w %>;background:#F59E0B;"></div></div>
        <span class="dbc-funnel-count"><%= pend_dh_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Pending Finance</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= pend_fin_w %>;background:#F59E0B;"></div></div>
        <span class="dbc-funnel-count"><%= pend_fin_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Approved</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= approved_w %>;background:#16AD78;"></div></div>
        <span class="dbc-funnel-count"><%= approved_n %></span>
      </div>
      <div class="dbc-funnel-row">
        <span class="dbc-funnel-stage">Rejected</span>
        <div class="dbc-funnel-track"><div class="dbc-funnel-fill" style="width:<%= rejected_w %>;background:#EF4444;"></div></div>
        <span class="dbc-funnel-count"><%= rejected_n %></span>
      </div>
    </div>

    <!-- ESCALATION LIST -->
    <div class="dbc-esc-card">
      <div class="dbc-esc-header">
        <h2 class="dbc-esc-title">Escalation &mdash; SLA Overdue</h2>
        <span class="dbc-esc-badge"><%= esc_badge %></span>
      </div>
      <div class="dbc-esc-item">
        <div class="dbc-esc-item-top">
          <span class="dbc-esc-id"><%= esc1_id %></span>
          <span class="dbc-esc-overdue"><%= esc1_days %> days overdue</span>
        </div>
        <div class="dbc-esc-meta"><%= esc1_dept %> &nbsp;&middot;&nbsp; <%= esc1_stage %></div>
      </div>
      <div class="dbc-esc-item">
        <div class="dbc-esc-item-top">
          <span class="dbc-esc-id"><%= esc2_id %></span>
          <span class="dbc-esc-overdue"><%= esc2_days %> days overdue</span>
        </div>
        <div class="dbc-esc-meta"><%= esc2_dept %> &nbsp;&middot;&nbsp; <%= esc2_stage %></div>
      </div>
    </div>
  </div>

  <!-- FOOTER: AVERAGE TURNAROUND -->
  <div class="dbc-footer-row">
    <span class="dbc-footer-label">Avg. Approval Turnaround</span>
    <span class="dbc-turnaround-badge"><strong>2-Person:</strong> 2.4 days</span>
    <span class="dbc-turnaround-badge"><strong>3-Person:</strong> 5.1 days</span>
  </div>

</div>
