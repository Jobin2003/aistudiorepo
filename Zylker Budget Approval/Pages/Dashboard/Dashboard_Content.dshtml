      insert into Request_Catalog [ Department = "IT & Systems" Item_Description = "Departmental laptop refresh (10 units)" Catalog_Cost = 48000 ];
      insert into Request_Catalog [ Department = "IT & Systems" Item_Description = "Server & network infrastructure upgrade" Catalog_Cost = 115000 ];
      insert into Request_Catalog [ Department = "HR & Admin" Item_Description = "Stationery & printing restock" Catalog_Cost = 210 ];
      insert into Request_Catalog [ Department = "HR & Admin" Item_Description = "HRMS software license renewal" Catalog_Cost = 11000 ];
      insert into Request_Catalog [ Department = "HR & Admin" Item_Description = "Cafeteria & facility renovation" Catalog_Cost = 69000 ];
    }

    sr_count = Spend_Request[ID != 0].count();
    if(sr_count == 0)
    {
      insert into Spend_Request [ Request_ID = "BRQ-2026-0301" Requester_Name = "Carlos Medina" Department = "Production" Requester_ID = "EMP-3011" Reporting_Manager_Name = "Jason Miller" Department_Head_Name = "Henrik Larsson" Item_Description = "PPE restock - gloves & face shields" Estimated_Cost = 850 Priority = "Low" Status = "Auto_Approved" Submitted_Date = "2026-08-01" SLA_Due_Date = "2026-08-01" Justification = "Routine safety consumables restock for production floor compliance." ];
