      insert into Spend_Request [ Request_ID = "BRQ-2026-0313" Requester_Name = "Daniel Cohen" Department = "IT & Systems" Requester_ID = "EMP-3055" Reporting_Manager_Name = "Liam O'Connor" Department_Head_Name = "Noah Bergstrom" Item_Description = "Keyboard/mouse replacement batch (20 units)" Estimated_Cost = 560 Priority = "Low" Status = "Auto_Approved" Submitted_Date = "2026-08-14" SLA_Due_Date = "2026-08-14" Justification = "Batch peripheral replacement for workstations with worn input devices." ];
