      insert into Spend_Request [ Request_ID = "BRQ-2026-0318" Requester_Name = "Priya Nair" Department = "HR & Admin" Requester_ID = "EMP-3068" Reporting_Manager_Name = "Sofia Martins" Department_Head_Name = "Chidi Eze" Item_Description = "Cafeteria & facility renovation" Estimated_Cost = 69000 Priority = "High" Status = "Approved" Submitted_Date = "2026-08-15" SLA_Due_Date = "2026-11-15" Justification = "Cafeteria infrastructure is overdue for renovation to meet health and safety standards." ];
    }

