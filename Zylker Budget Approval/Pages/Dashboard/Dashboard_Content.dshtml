    if(log_count == 0)
    {
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0301" Stage = "System" Approver_Name = "Carlos Medina" Decision = "Submitted" Decision_Timestamp = "2026-08-01 09:00:00" Comments = "Request submitted by Carlos Medina (Production)" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0301" Stage = "System" Approver_Name = "System" Decision = "Auto-Approved" Decision_Timestamp = "2026-08-01 09:01:00" Comments = "Auto-approved based on amount threshold (up to $1,000)" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0302" Stage = "System" Approver_Name = "Carlos Medina" Decision = "Submitted" Decision_Timestamp = "2026-09-10 09:00:00" Comments = "Request submitted by Carlos Medina (Production)" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0302" Stage = "Reporting Manager" Approver_Name = "Jason Miller" Decision = "Approved" Decision_Timestamp = "2026-09-12 10:15:00" Comments = "Approved by Reporting Manager Jason Miller, routed directly to Finance (2-Person tier)" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0303" Stage = "System" Approver_Name = "Carlos Medina" Decision = "Submitted" Decision_Timestamp = "2026-08-25 10:05:00" Comments = "Request submitted by Carlos Medina (Production)" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0303" Stage = "Reporting Manager" Approver_Name = "Jason Miller" Decision = "Approved" Decision_Timestamp = "2026-08-28 09:30:00" Comments = "Approved by Reporting Manager Jason Miller, routed to Department Head" ];
      insert into Approval_Log [ Request_ID_Ref = "BRQ-2026-0304" Stage = "System" Approver_Name = "Wei Zhang" Decision = "Submitted" Decision_Timestamp = "2026-08-03 08:30:00" Comments = "Request submitted by Wei Zhang (Maintenance & Utilities)" ];
