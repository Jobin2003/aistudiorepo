t;% if(esc1_id != &quot;-&quot;) { %&gt;\n\t\t\t&lt;div class=&quot;dbc-esc-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-id&quot;&gt;&lt;%= esc1_id %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-days&quot;&gt;&lt;%= esc1_days %&gt; days overdue&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-meta&quot;&gt;&lt;%= esc1_dept %&gt; &amp;middot; &lt;%= esc1_stage %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t\t&lt;% if(esc2_id != &quot;-&quot;) { %&gt;\n\t\t\t&lt;div class=&quot;dbc-esc-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-id&quot;&gt;&lt;%= esc2_id %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-days&quot;&gt;&lt;%= esc2_days %&gt; days overdue&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-meta&quot;&gt;&lt;%= esc2_dept %&gt; &amp;middot; &lt;%= esc2_stage %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t\t&lt;% if(esc1_id == &quot;-&quot; &amp;&amp; esc2_id == &quot;-&quot;) { %&gt;\n\t\t\t&lt;div style=&quot;font-size:13px;color:#9CA3AF;font-style:italic;padding:8px 0;&quot;&gt;No overdue requests at this time.&lt;/div&gt;\n\t\t\t&lt;% } %&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;dbc-footer&quot;&gt;\n\t\t&lt;span class=&quot;dbc-foot-lbl&quot;&gt;Avg. Approval Turnaround&lt;/span&gt;\n\t\t&lt;span class=&quot;dbc-turn-bdg&quot;&gt;&lt;strong&gt;2-Person:&lt;/strong&gt; 2.4 days&lt;/span&gt;\n\t\t&lt;span class=&quot;dbc-turn-bdg&quot;&gt;&lt;strong&gt;3-Person:&lt;/strong&gt; 5.1 days&lt;/span&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

