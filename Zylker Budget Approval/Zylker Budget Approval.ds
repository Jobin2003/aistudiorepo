	        }
	        Request_Catalog
	        {
	            enabled          = View, Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                Catalog_Items = {"View"}
	            }
	        }
	        Approval_Log
	        {
	            enabled          = View, Search
	            allFieldsVisible = true
	            ReportPermissions
	            {
	                All_Decisions = {"View"}
	            }
	        }
	        Request_Intake
	        {
	            enabled = tab
	        }
	        Dashboard
	        {
	            enabled = tab
	        }
	    }
	}
	}

