		{
					displayname = "Request Intake"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ri_form_info' elementName='Form_Card'>\n\t\t\t\t\t<![CDATA[htmlpage ri_form_info()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;link href=&apos;https://fonts.googleapis.com/css2?family=Lato:wght@400;600;700&amp;display=swap&apos; rel=&apos;stylesheet&apos;&gt;\n&lt;style&gt;\n\t.ri-wrap {\n\t\tpadding: 24px 28px 16px 28px;\n\t\tbackground: #F8FAFC;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tbox-sizing: border-box;\n\t}\n\t.ri-page-title {\n\t\tfont-size: 22px;\n\t\tfont-weight: 700;\n\t\tcolor: #111827;\n\t\tmargin: 0 0 4px 0;\n\t\tline-height: 1.3;\n\t}\n\t.ri-page-sub {\n\t\tfont-size: 13px;\n\t\tcolor: #6B7280;\n\t\tmargin: 0 0 20px 0;\n\t}\n\t.ri-context-card {\n\t\tbackground: #FFFFFF;\n\t\tborder-radius: 10px;\n\t\tbox-shadow: 0 1px 4px rgba(0,0,0,0.08);\n\t\tpadding: 20px 24px;\n\t\tmax-width: 920px;\n\t\tmargin-bottom: 4px;\n\t}\n\t.ri-info-strip {\n\t\tdisplay: flex;\n\t\talign-items: flex-start;\n\t\tgap: 10px;\n\t\tbackground: #EFF6FF;\n\t\tborder: 1px solid #BFDBFE;\n\t\tborder-radius: 8px;\n\t\tpadding: 12px 16px;\n\t\tmargin-bottom: 20px;\n\t}\n\t.ri-info-text {\n\t\tfont-size: 13px;\n\t\tcolor: #1D4ED8;\n\t\tfont-style: italic;\n\t\tline-height: 1.5;\n\t\tmargin: 0;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n\t.ri-divider {\n\t\tborder: none;\n\t\tborder-top: 1px solid #E5E7EB;\n\t\tmargin: 0 0 16px 0;\n\t}\n\t.ri-tier-lbl {\n\t\tfont-size: 11px;\n\t\tcolor: #6B7280;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.5px;\n\t\tfont-weight: 700;\n\t\tdisplay: block;\n\t\tmargin-bottom: 10px;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n\t.ri-tier-row {\n\t\tdisplay: flex;\n\t\tgap: 10px;\n\t\tflex-wrap: wrap;\n\t\talign-items: center;\n\t}\n\t.ri-badge {\n\t\tborder-radius: 20px;\n\t\tpadding: 5px 14px;\n\t\tfont-size: 12px;\n\t\tfont-weight: 700;\n\t\tdisplay: inline-block;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tline-height: 1.4;\n\t}\n\t.ri-auto  { background: #DCFCE7; color: #16AD78; }\n\t.ri-two   { background: #FEF9C3; color: #D97706; }\n\t.ri-three { background: #EFF6FF; color: #2563EB; }\n&lt;/style&gt;\n\n&lt;div class=&quot;ri-wrap&quot;&gt;\n\t&lt;h1 class=&quot;ri-page-title&quot;&gt;New Spend Request&lt;/h1&gt;\n\t&lt;p class=&quot;ri-page-sub&quot;&gt;Atlas Precision Manufacturing Inc. &amp;middot; Plant 3, Ohio, USA&lt;/p&gt;\n\n\t&lt;div class=&quot;ri-context-card&quot;&gt;\n\t\t&lt;div class=&quot;ri-info-strip&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-info-circle&quot; style=&quot;font-size:16px;color:#2563EB;flex-shrink:0;margin-top:2px;&quot;&gt;&lt;/i&gt;\n\t\t\t&lt;p class=&quot;ri-info-text&quot;&gt;Requester ID, Reporting Manager, and Department Head auto-resolve when your name and department match the Employee Directory. Item cost auto-fills from the Request Catalog when you select an item. The Approval Tier is calculated automatically from the cost entered.&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;hr class=&quot;ri-divider&quot;&gt;\n\t\t&lt;span class=&quot;ri-tier-lbl&quot;&gt;Approval Tier Thresholds&lt;/span&gt;\n\t\t&lt;div class=&quot;ri-tier-row&quot;&gt;\n\t\t\t&lt;span class=&quot;ri-badge ri-auto&quot;&gt;Auto - Up to $1,000&lt;/span&gt;\n\t\t\t&lt;span class=&quot;ri-badge ri-two&quot;&gt;2-Person - $1,001 to $50,000&lt;/span&gt;\n\t\t\t&lt;span class=&quot;ri-badge ri-three&quot;&gt;3-Person - $50,001 and above&lt;/span&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t\t<form elementName='Spend_Request_Form'\n\t\t\t\t\t\t\tappLinkName='thisapp'\n\t\t\t\t\t\t\tlinkName='Spend_Request'\n\t\t\t\t\t\t\theightType='auto'\n\t\t\t\t\t\t\tzc_Header='false'\n\t\t\t\t\t\t\turlType='report'\n\t\t\t\t\t\t\turlAppLinkName='thisapp'\n\t\t\t\t\t\t\tzc_NextUrl='#Report:Pending_Requests'\n\t\t\t\t\t\t\tzc_OpenUrlIn='same window'\n\t\t\t\t\t\t\tzc_SuccMsg='Your spend request has been submitted successfully.'\n\t\t\t\t\t\t\tzc_SubmitVal='Submit Request'\n\t\t\t\t\t\t\tzc_ResetVal='Clear' />\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Approval_Action_On_Success as "Update Request Status and Log Decision"
			{
			    type = form
			    form = Approval_Action
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Find the target Spend Request record
			                req_records = Spend_Request[Request_ID == input.Request_ID_Input];
			                for each req in req_records
			                {
			                    cost_val = req.Estimated_Cost;
			                    stage = input.Approver_Stage;
			                    decision = input.Decision;
			
			                    // Determine tier from cost
			                    if(cost_val <= 1000) { tier = "Auto"; }
			                    else if(cost_val <= 50000) { tier = "2-Person"; }
			                    else { tier = "3-Person"; }
			
			                    // Determine new status
			                    // Determine new status
			                    if(decision == "Approved")
			                    {
			                        if(stage == "Reporting Manager" && tier == "2-Person")
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                        else if(stage == "Reporting Manager" && tier == "3-Person")
			                        {
			                            new_status = "Pending_Dept_Head";
			                        }
			                        else if(stage == "Department Head")
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                        else if(stage == "Finance Controller")
			                        {
			                            new_status = "Approved";
			                        }
			                        else
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                    }
			                    else if(decision == "On_Hold")
			                    {
			                        new_status = "On_Hold";
			                    }
			                    else if(decision == "Rejected")
			                    {
			                        new_status = "Rejected";
			                    }
			                    else
			                    {
			                        new_status = "On_Hold";
			                    }
			
			                    // Update the Spend Request status
			                    update Spend_Request[ID == req.ID]
			                    [
			                        Status = new_status
			                    ];
			
			                    // Create Approval Log entry
			                    insert into Approval_Log
			                    [
			                        Request_ID_Ref = input.Request_ID_Input
			                        Stage = stage
			                        Approver_Name = input.Approver_Name
			                        Decision = decision
			                        Decision_Timestamp = zoho.currenttime
			                        Comments = input.Comments
			                    ];
			                    break;
			                }
			            )
			        }
			    }
			}

