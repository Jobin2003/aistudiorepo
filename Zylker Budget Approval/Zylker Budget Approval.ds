;width:&lt;%= qa_w %&gt;;opacity:0.85;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= qa_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Production&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= prod_w %&gt;;opacity:0.75;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= prod_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Maintenance &amp;amp; Util.&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= maint_w %&gt;;opacity:0.65;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= maint_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Procurement &amp;amp; Stores&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= proc_w %&gt;;opacity:0.55;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= proc_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;HR &amp;amp; Admin&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= hr_w %&gt;;opacity:0.45;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= hr_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;div class=&quot;dbc-row3&quot;&gt;\n\t\t&lt;div class=&quot;dbc-funnel-card&quot;&gt;\n\t\t\t&lt;h2 cl