	web
	{
	forms
	{
	    form Spend_Request
	    {
	        label placement = top
	    }
	    form Employee_Directory
	    {
	        label placement = left
	    }
	    form Request_Catalog
	    {
	        label placement = left
	    }
	    form Approval_Log
	    {
	        label placement = left
	    }
	    form Approval_Action
	    {
	        label placement = top
	    }
	}
	reports
	{
		report Approval_Actions
		{
		    quickview
		    (
		        layout
		        (
		            type = -1
		            datablock1
		            (
		                layout type = -1
		                fields
		                (
		                    Request_ID_Input
		                    Approver_Name
		                    Approver_Stage
		                    Decision
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		            record
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		        action
		        (
		            on click
		            (
		                View Record
		            )
		            on right click
		            (
		                Edit
		                Delete
		                Duplicate
		                View Record
		            )
		        )
		    )
		    detailview
		    (
		        layout
		        (
		            type = 1
		            datablock1
		            (
		                layout type = -2
		                fields
		                (
		                    Request_ID_Input
		                    Approver_Name
		                    Approver_Stage
		                    Decision
		                    Comments
		                )
		            )
		        )
		        menu
		        (
		            header
		            (
		                Edit
		                Duplicate
		                Delete
		            )
		        )
		    )
		}
	
		report All_Decisions
		{
		    quickview
		    (
		        layout
