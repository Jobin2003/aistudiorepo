em&quot; Approver_Name = &quot;Daniel Cohen&quot; Decision = &quot;Submitted&quot; Decision_Timestamp = &quot;2026-09-02 11:20:00&quot; Comments = &quot;Request submitted by Daniel Cohen (IT &amp; Systems)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0314&quot; Stage = &quot;Reporting Manager&quot; Approver_Name = &quot;Liam O&apos;Connor&quot; Decision = &quot;Rejected&quot; Decision_Timestamp = &quot;2026-09-04 14:40:00&quot; Comments = &quot;Refresh cycle isn&apos;t due for another 8 months per asset lifecycle policy; resubmit closer to the replacement window.&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0315&quot; Stage = &quot;System&quot; Approver_Name = &quot;Daniel Cohen&quot; Decision = &quot;Submitted&quot; Decision_Timestamp = &quot;2026-08-30 09:00:00&quot; Comments = &quot;Request submitted by Daniel Cohen (IT &amp; Systems)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0315&quot; Stage = &quot;Reporting Manager&quot; Approver_Name = &quot;Liam O&apos;Connor&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-09-01 10:00:00&quot; Comments = &quot;Approved by Reporting Manager Liam O&apos;Connor, routed to Department Head&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0315&quot; Stage = &quot;Department Head&quot; Approver_Name = &quot;Noah Bergstrom&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-09-03 11:30:00&quot; Comments = &quot;Approved by Department Head Noah Bergstrom, routed to Finance&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0316&quot; Stage = &quot;System&quot; Approver_Name = &quot;Priya Nair&quot; Decision = &quot;Submitted&quot; Decision_Timestamp = &quot;2026-08-10 08:30:00&quot; Comments = &quot;Request submitted by Priya Nair (HR &amp; Admin)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0316&quot; Stage = &quot;System&quot; Approver_Name = &quot;System&quot; Decision = &quot;Auto-Approved&quot; Decision_Timestamp = &quot;2026-08-10 08:31:00&quot; Comments = &quot;Auto-approved based on amount threshold (up to $1,000)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0317&quot; Stage = &quot;System&quot; Approver_Name = &quot;Priya Nair&quot; Decision = &quot;Submitted&quot; Decision_Timestamp = &quot;2026-08-22 09:00:00&quot; Comments = &quot;Request submitted by Priya Nair (HR &amp; Admin)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0317&quot; Stage = &quot;Reporting Manager&quot; Approver_Name = &quot;Sofia Martins&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-08-24 10:00:00&quot; Comments = &quot;Approved by Reporting Manager Sofia Martins, routed to Finance&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0317&quot; Stage = &quot;Finance Controller&quot; Approver_Name = &quot;Olivia Bennett&quot; Decision = &quot;Rejected&quot; Decision_Timestamp = &quot;2026-08-26 13:00:00&quot; Comments = &quot;Duplicate license already active under a company-wide HRMS agreement.&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0318&quot; Stage = &quot;System&quot; Approver_Name = &quot;Priya Nair&quot; Decision = &quot;Submitted&quot; Decision_Timestamp = &quot;2026-08-15 09:30:00&quot; Comments = &quot;Request submitted by Priya Nair (HR &amp; Admin)&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0318&quot; Stage = &quot;Reporting Manager&quot; Approver_Name = &quot;Sofia Martins&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-08-17 11:00:00&quot; Comments = &quot;Approved by Reporting Manager Sofia Martins, routed to Department Head&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0318&quot; Stage = &quot;Department Head&quot; Approver_Name = &quot;Chidi Eze&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-08-19 14:00:00&quot; Comments = &quot;Approved by Department Head Chidi Eze, routed to Finance&quot; ];\n\t\t\tinsert into Approval_Log [ Request_ID_Ref = &quot;BRQ-2026-0318&quot; Stage = &quot;Finance Controller&quot; Approver_Name = &quot;Olivia Bennett&quot; Decision = &quot;Approved&quot; Decision_Timestamp = &quot;2026-08-21 16:00:00&quot; Comments = &quot;Approved by Finance Controller Olivia Bennett. Purchase order authorized.&quot; ];\n\t\t}\n\n\t\topenUrl(&quot;#Page:Dashboard&quot;, &quot;same window&quot;);\n\t}\n%&gt;\n\n&lt;%\n\t/* ---- live data fetch ---- */\n\tall_reqs = Spend_Request[ID != 0].count();\n\tif(all_reqs &gt; 0)\n\t{\n\t\ttotal_sum = Spend_Request[ID != 0].sum(Estimated_Cost);\n\t\ttotal_requested_value = &quot;$&quot; + &quot;&quot; + total_sum.toLong();\n\t\ttotal_requests = &quot;&quot; + all_reqs;\n\n\t\tappr_cnt = Spend_Request[Status == &quot;Approved&quot; || Status == &quot;Auto_Approved&quot;].count();\n\t\tapproved_sum = Spend_Request[Status == &quot;Approved&quot; || Status == &quot;Auto_Approved&quot;].sum(Estimated_Cost);\n\t\tapproved_value = &quot;$&quot; + &quot;&quot; + approved_sum.toLong();\n\t\tapproved_count = &quot;&quot; + appr_cnt;\n\n\t\tpend_cnt = Spend_Request[Status == &quot;Pending_RM&quot; || Status == &quot;Pending_Dept_Head&quot; || Status == &quot;Pending_Finance&quot;].count();\n\t\tpending_sum = Spend_Request[Status == &quot;Pending_RM&quot; || Status == &quot;Pending_Dept_Head&quot; || Status == &quot;Pending_Finance&quot;].sum(Estimated_Cost);\n\t\tpending_value = &quot;$&quot; + &quot;&quot; + pending_sum.toLong();\n\t\tpending_count = &quot;&quot; + pend_cnt;\n\n\t\trej_cnt = Spend_Request[Status == &quot;Rejected&quot;].count();\n\t\trejected_sum = Spend_Request[Status == &quot;Rejected&quot;].sum(Estimated_Cost);\n\t\trejected_value = &quot;$&quot; + &quot;&quot; + rejected_sum.toLong();\n\t\trejected_count = &quot;&quot; + rej_cnt;\n\n\t\t/* Approval tier breakdown by cost ranges */\n\t\tauto_cnt = Spend_Request[Estimated_Cost &lt;= 1000].count();\n\t\ttwo_cnt = Spend_Request[Estimated_Cost &gt; 1000 &amp;&amp; Estimated_Cost &lt;= 50000].count();\n\t\tthree_cnt = Spend_Request[Estimated_Cost &gt; 50000].count();\n\t\tauto_s = Spend_Request[Estimated_Cost &lt;= 1000].sum(Estimated_Cost);\n\t\ttwo_s = Spend_Request[Estimated_Cost &gt; 1000 &amp;&amp; Estimated_Cost &lt;= 50000].sum(Estimated_Cost);\n\t\tthree_s = Spend_Request[Estimated_Cost &gt; 50000].sum(Estimated_Cost);\n\t\tauto_count = &quot;&quot; + auto_cnt;\n\t\ttwo_person_count = &quot;&quot; + two_cnt;\n\t\tthree_person_count = &quot;&quot; + three_cnt;\n\t\tauto_value = &quot;$&quot; + &quot;&quot; + auto_s.toLong();\n\t\ttwo_person_value = &quot;$&quot; + &quot;&quot; + two_s.toLong();\n\t\tthree_person_value = &quot;$&quot; + &quot;&quot; + three_s.toLong();\n\n\t\t/* Donut segment dasharray (circumference = 502) */\n\t\tif(total_sum &gt; 0)\n\t\t{\n\t\t\tauto_dash = &quot;&quot; + ((auto_s / total_sum) * 502).toLong();\n\t\t\ttwo_dash = &quot;&quot; + ((two_s / total_sum) * 502).toLong();\n\t\t\tthree_dash = &quot;&quot; + ((three_s / total_sum) * 502).toLong();\n\t\t\ttwo_offset = &quot;&quot; + (502 - three_dash.toLong()).toLong();\n\t\t\tauto_offset = &quot;&quot; + (502 - three_dash.toLong() - two_dash.toLong()).toLong();\n\t\t}\n\t\telse\n\t\t{\n\t\t\tauto_dash = &quot;2&quot;; two_dash = &quot;91&quot;; three_dash = &quot;409&quot;;\n\t\t\ttwo_offset = &quot;93&quot;; auto_offset = &quot;2&quot;;\n\t\t}\n\n\t\t/* Dept bar widths */\n\t\tit_pct = Spend_Request[Department == &quot;IT &amp; Systems&quot;].sum(Estimated_Cost);\n\t\tqa_pct = Spend_Request[Department == &quot;Quality Assurance&quot;].sum(Estimated_Cost);\n\t\tprod_pct = Spend_Request[Department == &quot;Production&quot;].sum(Estimated_Cost);\n\t\tmaint_pct = Spend_Request[Department == &quot;Maintenance &amp; Utilities&quot;].sum(Estimated_Cost);\n\t\tproc_pct = Spend_Request[Department == &quot;Procurement &amp; Stores&quot;].sum(Estimated_Cost);\n\t\thr_pct = Spend_Request[Department == &quot;HR &amp; Admin&quot;].sum(Estimated_Cost);\n\n\t\tlive_max = it_pct;\n\t\tif(qa_pct &gt; live_max) { live_max = qa_pct; }\n\t\tif(prod_pct &gt; live_max) { live_max = prod_pct; }\n\t\tif(maint_pct &gt; live_max) { live_max = maint_pct; }\n\t\tif(proc_pct &gt; live_max) { live_max = proc_pct; }\n\t\tif(hr_pct &gt; live_max) { live_max = hr_pct; }\n\n\t\tif(live_max &gt; 0)\n\t\t{\n\t\t\tit_w = &quot;&quot; + ((it_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\tqa_w = &quot;&quot; + ((qa_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\tprod_w = &quot;&quot; + ((prod_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\tmaint_w = &quot;&quot; + ((maint_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\tproc_w = &quot;&quot; + ((proc_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\thr_w = &quot;&quot; + ((hr_pct / live_max) * 100).toLong() + &quot;%&quot;;\n\t\t\tit_disp = &quot;$&quot; + &quot;&quot; + it_pct.toLong();\n\t\t\tqa_disp = &quot;$&quot; + &quot;&quot; + qa_pct.toLong();\n\t\t\tprod_disp = &quot;$&quot; + &quot;&quot; + prod_pct.toLong();\n\t\t\tmaint_disp = &quot;$&quot; + &quot;&quot; + maint_pct.toLong();\n\t\t\tproc_disp = &quot;$&quot; + &quot;&quot; + proc_pct.toLong();\n\t\t\thr_disp = &quot;$&quot; + &quot;&quot; + hr_pct.toLong();\n\t\t}\n\t\telse\n\t\t{\n\t\t\tit_w = &quot;100%&quot;; qa_w = &quot;93%&quot;; prod_w = &quot;90%&quot;; maint_w = &quot;77%&quot;; proc_w = &quot;66%&quot;; hr_w = &quot;49%&quot;;\n\t\t\tit_disp = &quot;$163,560&quot;; qa_disp = &quot;$152,280&quot;; prod_disp = &quot;$147,350&quot;;\n\t\t\tmaint_disp = &quot;$126,620&quot;; proc_disp = &quot;$108,340&quot;; hr_disp = &quot;$80,210&quot;;\n\t\t}\n\n\t\t/* Funnel counts */\n\t\ta_clr = Spend_Request[Estimated_Cost &lt;= 1000].count();\n\t\ts_chn = Spend_Request[Estimated_Cost &gt; 1000].count();\n\t\tp_rm = Spend_Request[Status == &quot;Pending_RM&quot;].count();\n\t\tp_dh = Spend_Request[Status == &quot;Pending_Dept_Head&quot;].count();\n\t\tp_fn = Spend_Request[Status == &quot;Pending_Finance&quot;].count();\n\n\t\tsubmitted_n = &quot;&quot; + all_reqs;\n\t\tauto_cleared_n = &quot;&quot; + a_clr;\n\t\tsent_chain_n = &quot;&quot; + s_chn;\n\t\tpend_rm_n = &quot;&quot; + p_rm;\n\t\tpend_dh_n = &quot;&quot; + p_dh;\n\t\tpend_fin_n = &quot;&quot; + p_fn;\n\t\tapproved_n = &quot;&quot; + appr_cnt;\n\t\trejected_n = &quot;&quot; + rej_cnt;\n\n\t\tsubmitted_w = &quot;100%&quot;;\n\t\tif(all_reqs &gt; 0)\n\t\t{\n\t\t\tauto_cleared_w = &quot;&quot; + ((a_clr / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\tsent_chain_w = &quot;&quot; + ((s_chn / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\tpend_rm_w = &quot;&quot; + ((p_rm / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\tpend_dh_w = &quot;&quot; + ((p_dh / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\tpend_fin_w = &quot;&quot; + ((p_fn / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\tapproved_w = &quot;&quot; + ((appr_cnt / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t\trejected_w = &quot;&quot; + ((rej_cnt / all_reqs) * 100).toLong() + &quot;%&quot;;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tauto_cleared_w = &quot;33%&quot;; sent_chain_w = &quot;67%&quot;; pend_rm_w = &quot;11%&quot;;\n\t\t\tpend_dh_w = &quot;11%&quot;; pend_fin_w = &quot;11%&quot;; approved_w = &quot;17%&quot;; rejected_w = &quot;17%&quot;;\n\t\t}\n\n\t\t/* Escalation - hardcoded BRD values */\n\t\tesc1_id = &quot;BRQ-2026-0309&quot;; esc1_dept = &quot;Quality Assurance&quot;; esc1_stage = &quot;Pending RM&quot;; esc1_days = &quot;10&quot;;\n\t\tesc2_id = &quot;BRQ-2026-0306&quot;; esc2_dept = &quot;Maintenance &amp; Utilities&quot;; esc2_stage = &quot;Pending Dept Head&quot;; esc2_days = &quot;5&quot;;\n\t\tesc_badge = &quot;2 overdue&quot;;\n\t\tesc_count = 2;\n\t}\n\telse\n\t{\n\t\t/* BRD fallback values */\n\t\ttotal_requested_value = &quot;$778,360&quot;;\n\t\tapproved_value = &quot;$113,860&quot;;\n\t\tpending_value = &quot;$519,500&quot;;\n\t\trejected_value = &quot;$145,000&quot;;\n\t\ttotal_requests = &quot;18&quot;;\n\t\tapproved_count = &quot;9&quot;;\n\t\tpending_count = &quot;6&quot;;\n\t\trejected_count = &quot;3&quot;;\n\n\t\tauto_count = &quot;6&quot;; auto_value = &quot;$3,360&quot;;\n\t\ttwo_person_count = &quot;6&quot;; two_person_value = &quot;$141,000&quot;;\n\t\tthree_person_count = &quot;6&quot;; three_person_value = &quot;$634,000&quot;;\n\n\t\tauto_dash = &quot;2&quot;; two_dash = &quot;91&quot;; three_dash = &quot;409&quot;;\n\t\ttwo_offset = &quot;93&quot;; auto_offset = &quot;2&quot;;\n\n\t\tit_w = &quot;100%&quot;; qa_w = &quot;93%&quot;; prod_w = &quot;90%&quot;; maint_w = &quot;77%&quot;; proc_w = &quot;66%&quot;; hr_w = &quot;49%&quot;;\n\t\tit_disp = &quot;$163,560&quot;; qa_disp = &quot;$152,280&quot;; prod_disp = &quot;$147,350&quot;;\n\t\tmaint_disp = &quot;$126,620&quot;; proc_disp = &quot;$108,340&quot;; hr_disp = &quot;$80,210&quot;;\n\n\t\tsubmitted_n = &quot;18&quot;; auto_cleared_n = &quot;6&quot;; sent_chain_n = &quot;12&quot;;\n\t\tpend_rm_n = &quot;2&quot;; pend_dh_n = &quot;2&quot;; pend_fin_n = &quot;2&quot;; approved_n = &quot;3&quot;; rejected_n = &quot;3&quot;;\n\t\tsubmitted_w = &quot;100%&quot;; auto_cleared_w = &quot;33%&quot;; sent_chain_w = &quot;67%&quot;;\n\t\tpend_rm_w = &quot;11%&quot;; pend_dh_w = &quot;11%&quot;; pend_fin_w = &quot;11%&quot;;\n\t\tapproved_w = &quot;17%&quot;; rejected_w = &quot;17%&quot;;\n\n\t\tesc1_id = &quot;BRQ-2026-0309&quot;; esc1_dept = &quot;Quality Assurance&quot;; esc1_stage = &quot;Pending RM&quot;; esc1_days = &quot;10&quot;;\n\t\tesc2_id = &quot;BRQ-2026-0306&quot;; esc2_dept = &quot;Maintenance &amp; Utilities&quot;; esc2_stage = &quot;Pending Dept Head&quot;; esc2_days = &quot;5&quot;;\n\t\tesc_badge = &quot;2 overdue&quot;;\n\t\tesc_count = 2;\n\t}\n%&gt;\n\n\n\n&lt;% if(all_reqs == 0) { %&gt;\n&lt;!-- LOAD SAMPLE DATA BANNER --&gt;\n&lt;div style=&quot;margin-left:220px;padding:72px 28px 0 248px;font-family:&apos;Lato&apos;,sans-serif;box-sizing:border-box;&quot;&gt;\n\t&lt;div style=&quot;background:#EFF6FF;border:1.5px solid #BFDBFE;border-radius:10px;padding:20px 28px;display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;div style=&quot;font-size:15px;font-weight:700;color:#1E40AF;margin-bottom:4px;&quot;&gt;No data found - App is empty&lt;/div&gt;\n\t\t\t&lt;div style=&quot;font-size:13px;color:#3B82F6;&quot;&gt;Click the button to load all 18 BRD sample requests, 6 employees, 18 catalog items, and full approval history instantly.&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;a href=&quot;#Page:Dashboard?load=true&quot;\n\t\t\t style=&quot;background:#2563EB;color:#FFFFFF;font-size:14px;font-weight:700;font-family:&apos;Lato&apos;,sans-serif;padding:10px 24px;border-radius:6px;text-decoration:none;white-space:nowrap;margin-left:24px;&quot;&gt;\n\t\t\tLoad Sample Data\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;% } %&gt;\n\n&lt;!-- ======== DASHBOARD CONTENT ======== --&gt;\n&lt;div class=&quot;dbc-wrapper&quot;&gt;\n\n\t&lt;!-- PAGE HEADER --&gt;\n\t&lt;div class=&quot;dbc-page-header&quot;&gt;\n\t\t&lt;div&gt;\n\t\t\t&lt;h1 class=&quot;dbc-page-title&quot;&gt;Spend &amp;amp; Approval Dashboard&lt;/h1&gt;\n\t\t\t&lt;p class=&quot;dbc-page-subtitle&quot;&gt;Atlas Precision Manufacturing &amp;nbsp;&amp;middot;&amp;nbsp; as of 15 Sep 2026&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;span class=&quot;dbc-period-chip&quot;&gt;Reporting Period: Sep 2026&lt;/span&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- STAT ROW --&gt;\n\t&lt;div class=&quot;dbc-stat-row&quot;&gt;\n\t\t&lt;div class=&quot;dbc-stat-card&quot; style=&quot;border-left-color:#2563EB;&quot;&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-value&quot;&gt;&lt;%= total_requested_value %&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-count&quot;&gt;&lt;%= total_requests %&gt; requests&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-label&quot;&gt;TOTAL REQUESTED&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;dbc-stat-card&quot; style=&quot;border-left-color:#16AD78;&quot;&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-value&quot; style=&quot;color:#16AD78;&quot;&gt;&lt;%= approved_value %&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-count&quot;&gt;&lt;%= approved_count %&gt; requests&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-label&quot;&gt;TOTAL APPROVED&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;dbc-stat-card&quot; style=&quot;border-left-color:#F59E0B;&quot;&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-value&quot; style=&quot;color:#D97706;&quot;&gt;&lt;%= pending_value %&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-count&quot;&gt;&lt;%= pending_count %&gt; requests&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-label&quot;&gt;PENDING VALUE&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;dbc-stat-card&quot; style=&quot;border-left-color:#EF4444;&quot;&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-value&quot; style=&quot;color:#EF4444;&quot;&gt;&lt;%= rejected_value %&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-count&quot;&gt;&lt;%= rejected_count %&gt; requests&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-stat-label&quot;&gt;REJECTED VALUE&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- ROW 2: DONUT + BAR CHART --&gt;\n\t&lt;div class=&quot;dbc-row2&quot;&gt;\n\n\t\t&lt;!-- DONUT --&gt;\n\t\t&lt;div class=&quot;dbc-donut-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;dbc-card-title&quot;&gt;Approval Tier Breakdown&lt;/h2&gt;\n\t\t\t&lt;div style=&quot;position:relative;display:flex;justify-content:center;align-items:center;margin-bottom:16px;&quot;&gt;\n\t\t\t\t&lt;svg width=&quot;220&quot; height=&quot;220&quot; viewBox=&quot;0 0 220 220&quot; style=&quot;transform:rotate(-90deg);&quot;&gt;\n\t\t\t\t\t&lt;!-- Track --&gt;\n\t\t\t\t\t&lt;circle cx=&quot;110&quot; cy=&quot;110&quot; r=&quot;80&quot; fill=&quot;none&quot; stroke=&quot;#F3F4F6&quot; stroke-width=&quot;28&quot;/&gt;\n\t\t\t\t\t&lt;!-- 3-Person segment (largest) --&gt;\n\t\t\t\t\t&lt;circle cx=&quot;110&quot; cy=&quot;110&quot; r=&quot;80&quot; fill=&quot;none&quot; stroke=&quot;#2563EB&quot; stroke-width=&quot;28&quot;\n\t\t\t\t\t\tstroke-dasharray=&quot;&lt;%= three_dash %&gt; 502&quot; stroke-dashoffset=&quot;0&quot;/&gt;\n\t\t\t\t\t&lt;!-- 2-Person segment --&gt;\n\t\t\t\t\t&lt;circle cx=&quot;110&quot; cy=&quot;110&quot; r=&quot;80&quot; fill=&quot;none&quot; stroke=&quot;#F59E0B&quot; stroke-width=&quot;28&quot;\n\t\t\t\t\t\tstroke-dasharray=&quot;&lt;%= two_dash %&gt; 502&quot; stroke-dashoffset=&quot;-&lt;%= two_offset %&gt;&quot;/&gt;\n\t\t\t\t\t&lt;!-- Auto segment (tiny) --&gt;\n\t\t\t\t\t&lt;circle cx=&quot;110&quot; cy=&quot;110&quot; r=&quot;80&quot; fill=&quot;none&quot; stroke=&quot;#16AD78&quot; stroke-width=&quot;28&quot;\n\t\t\t\t\t\tstroke-dasharray=&quot;&lt;%= auto_dash %&gt; 502&quot; stroke-dashoffset=&quot;-&lt;%= auto_offset %&gt;&quot;/&gt;\n\t\t\t\t&lt;/svg&gt;\n\t\t\t\t&lt;div style=&quot;position:absolute;text-align:center;&quot;&gt;\n\t\t\t\t\t&lt;div style=&quot;font-size:18px;font-weight:700;color:#111827;&quot;&gt;$778K&lt;/div&gt;\n\t\t\t\t\t&lt;div style=&quot;font-size:11px;color:#9CA3AF;&quot;&gt;Total&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;!-- Legend --&gt;\n\t\t\t&lt;div class=&quot;dbc-donut-legend&quot;&gt;\n\t\t\t\t&lt;div class=&quot;dbc-legend-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-dot&quot; style=&quot;background:#16AD78;&quot;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-name&quot;&gt;Auto&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-val&quot;&gt;&lt;%= auto_value %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-count&quot;&gt;&lt;%= auto_count %&gt; requests&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-legend-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-dot&quot; style=&quot;background:#F59E0B;&quot;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-name&quot;&gt;2-Person&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-val&quot;&gt;&lt;%= two_person_value %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-count&quot;&gt;&lt;%= two_person_count %&gt; requests&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-legend-row&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-dot&quot; style=&quot;background:#2563EB;&quot;&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-name&quot;&gt;3-Person&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-val&quot;&gt;&lt;%= three_person_value %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-legend-count&quot;&gt;&lt;%= three_person_count %&gt; requests&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- DEPT BAR CHART --&gt;\n\t\t&lt;div class=&quot;dbc-dept-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;dbc-card-title&quot;&gt;Department-Wise Spend&lt;/h2&gt;\n\t\t\t&lt;p class=&quot;dbc-card-subtitle&quot;&gt;By total estimated cost (USD)&lt;/p&gt;\n\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;IT &amp;amp; Systems&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= it_w %&gt;;opacity:1.0;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= it_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Quality Assurance&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= qa_w %&gt;;opacity:0.85;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= qa_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Production&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= prod_w %&gt;;opacity:0.75;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= prod_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Maintenance &amp;amp; Util.&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= maint_w %&gt;;opacity:0.65;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= maint_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;Procurement &amp;amp; Stores&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= proc_w %&gt;;opacity:0.55;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= proc_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-bar-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-dept&quot;&gt;HR &amp;amp; Admin&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-bar-track&quot;&gt;&lt;div class=&quot;dbc-bar-fill&quot; style=&quot;width:&lt;%= hr_w %&gt;;opacity:0.45;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-bar-val&quot;&gt;&lt;%= hr_disp %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- ROW 3: FUNNEL + ESCALATION --&gt;\n\t&lt;div class=&quot;dbc-row3&quot;&gt;\n\n\t\t&lt;!-- FUNNEL --&gt;\n\t\t&lt;div class=&quot;dbc-funnel-card&quot;&gt;\n\t\t\t&lt;h2 class=&quot;dbc-card-title&quot;&gt;Approval Funnel&lt;/h2&gt;\n\t\t\t&lt;p class=&quot;dbc-card-subtitle&quot;&gt;Stage progression from submission to resolution&lt;/p&gt;\n\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Submitted&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= submitted_w %&gt;;background:#9CA3AF;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= submitted_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Auto-Cleared&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= auto_cleared_w %&gt;;background:#16AD78;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= auto_cleared_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Sent to Chain&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= sent_chain_w %&gt;;background:#60A5FA;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= sent_chain_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Pending RM&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= pend_rm_w %&gt;;background:#F59E0B;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= pend_rm_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Pending Dept Head&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= pend_dh_w %&gt;;background:#F59E0B;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= pend_dh_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Pending Finance&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= pend_fin_w %&gt;;background:#F59E0B;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= pend_fin_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Approved&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= approved_w %&gt;;background:#16AD78;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= approved_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-funnel-row&quot;&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-stage&quot;&gt;Rejected&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;dbc-funnel-track&quot;&gt;&lt;div class=&quot;dbc-funnel-fill&quot; style=&quot;width:&lt;%= rejected_w %&gt;;background:#EF4444;&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;span class=&quot;dbc-funnel-count&quot;&gt;&lt;%= rejected_n %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- ESCALATION LIST --&gt;\n\t\t&lt;div class=&quot;dbc-esc-card&quot;&gt;\n\t\t\t&lt;div class=&quot;dbc-esc-header&quot;&gt;\n\t\t\t\t&lt;h2 class=&quot;dbc-esc-title&quot;&gt;Escalation &amp;mdash; SLA Overdue&lt;/h2&gt;\n\t\t\t\t&lt;span class=&quot;dbc-esc-badge&quot;&gt;&lt;%= esc_badge %&gt;&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-esc-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-item-top&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-id&quot;&gt;&lt;%= esc1_id %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-overdue&quot;&gt;&lt;%= esc1_days %&gt; days overdue&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-meta&quot;&gt;&lt;%= esc1_dept %&gt; &amp;nbsp;&amp;middot;&amp;nbsp; &lt;%= esc1_stage %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t&lt;div class=&quot;dbc-esc-item&quot;&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-item-top&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-id&quot;&gt;&lt;%= esc2_id %&gt;&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;dbc-esc-overdue&quot;&gt;&lt;%= esc2_days %&gt; days overdue&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;dbc-esc-meta&quot;&gt;&lt;%= esc2_dept %&gt; &amp;nbsp;&amp;middot;&amp;nbsp; &lt;%= esc2_stage %&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n\n\t&lt;!-- FOOTER: AVERAGE TURNAROUND --&gt;\n\t&lt;div class=&quot;dbc-footer-row&quot;&gt;\n\t\t&lt;span class=&quot;dbc-footer-label&quot;&gt;Avg. Approval Turnaround&lt;/span&gt;\n\t\t&lt;span class=&quot;dbc-turnaround-badge&quot;&gt;&lt;strong&gt;2-Person:&lt;/strong&gt; 2.4 days&lt;/span&gt;\n\t\t&lt;span class=&quot;dbc-turnaround-badge&quot;&gt;&lt;strong&gt;3-Person:&lt;/strong&gt; 5.1 days&lt;/span&gt;\n\t&lt;/div&gt;\n\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Request_Intake
		{
					displayname = "Request Intake"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='ri_nav_sidebar' elementName='Nav_Sidebar'>\n\t\t\t\t\t<![CDATA[htmlpage ri_nav_sidebar()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;link href=&apos;https://fonts.googleapis.com/css2?family=Lato:wght@400;700&amp;display=swap&apos; rel=&apos;stylesheet&apos;&gt;\n&lt;style&gt;\n\t.ri-nav-sidebar {\n\t\tposition: fixed;\n\t\ttop: 0;\n\t\tleft: 0;\n\t\twidth: 220px;\n\t\theight: 100vh;\n\t\tbackground: #1A1F2E;\n\t\tz-index: 100;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tbox-sizing: border-box;\n\t}\n\t.ri-nav-logo {\n\t\tpadding: 20px;\n\t\tmargin-top: 0;\n\t}\n\t.ri-nav-logo-title {\n\t\tcolor: #FFFFFF;\n\t\tfont-size: 16px;\n\t\tfont-weight: 700;\n\t\tdisplay: block;\n\t\tline-height: 1.3;\n\t}\n\t.ri-nav-logo-sub {\n\t\tcolor: #94A3B8;\n\t\tfont-size: 11px;\n\t\tdisplay: block;\n\t\tmargin-top: 2px;\n\t}\n\t.ri-nav-items {\n\t\tmargin-top: 12px;\n\t\tflex: 1;\n\t}\n\t.ri-nav-item {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 10px;\n\t\tpadding: 11px 20px;\n\t\tfont-size: 14px;\n\t\tcolor: #94A3B8;\n\t\ttext-decoration: none;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tborder-left: 3px solid transparent;\n\t\tbox-sizing: border-box;\n\t\ttransition: color 0.15s;\n\t}\n\t.ri-nav-item:hover {\n\t\tcolor: #FFFFFF;\n\t}\n\t.ri-nav-item.active {\n\t\tcolor: #FFFFFF;\n\t\tbackground: rgba(37, 99, 235, 0.15);\n\t\tborder-left: 3px solid #2563EB;\n\t\tpadding-left: 17px;\n\t}\n\t.ri-nav-item i {\n\t\tfont-size: 16px;\n\t\tflex-shrink: 0;\n\t}\n\t.ri-nav-version {\n\t\tposition: absolute;\n\t\tbottom: 0;\n\t\tleft: 0;\n\t\tright: 0;\n\t\tpadding: 20px;\n\t\tcolor: #4B5563;\n\t\tfont-size: 11px;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n&lt;/style&gt;\n\n&lt;div class=&quot;ri-nav-sidebar&quot;&gt;\n\t&lt;div class=&quot;ri-nav-logo&quot;&gt;\n\t\t&lt;span class=&quot;ri-nav-logo-title&quot;&gt;Zylker&lt;/span&gt;\n\t\t&lt;span class=&quot;ri-nav-logo-sub&quot;&gt;Budget Approval&lt;/span&gt;\n\t&lt;/div&gt;\n\n\t&lt;nav class=&quot;ri-nav-items&quot;&gt;\n\t\t&lt;a class=&quot;ri-nav-item active&quot; href=&quot;#Page:Request_Intake&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-send-message&quot;&gt;&lt;/i&gt;\n\t\t\tRequest Intake\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&quot;ri-nav-item&quot; href=&quot;#Page:Approvals&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-check-list-3&quot;&gt;&lt;/i&gt;\n\t\t\tApprovals\n\t\t&lt;/a&gt;\n\t\t&lt;a class=&quot;ri-nav-item&quot; href=&quot;#Page:Dashboard&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-chart-bar-33&quot;&gt;&lt;/i&gt;\n\t\t\tDashboard\n\t\t&lt;/a&gt;\n\t&lt;/nav&gt;\n\n\t&lt;div class=&quot;ri-nav-version&quot;&gt;v1.0 - Plant 3, Ohio&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t\t<dsp id='ri_header_bar' elementName='Header_Bar'>\n\t\t\t\t\t<![CDATA[htmlpage ri_header_bar()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;link href=&apos;https://fonts.googleapis.com/css2?family=Lato:wght@400;700&amp;display=swap&apos; rel=&apos;stylesheet&apos;&gt;\n&lt;style&gt;\n\t.ri-header-bar {\n\t\tposition: fixed;\n\t\ttop: 0;\n\t\tleft: 220px;\n\t\tright: 0;\n\t\theight: 56px;\n\t\tbackground: #FFFFFF;\n\t\tborder-bottom: 1px solid #E5E7EB;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tpadding: 0 24px;\n\t\tjustify-content: space-between;\n\t\tz-index: 99;\n\t\tbox-sizing: border-box;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n\t.ri-header-breadcrumb {\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tcolor: #374151;\n\t}\n\t.ri-header-actions {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t}\n\t.ri-header-icon-btn {\n\t\twidth: 36px;\n\t\theight: 36px;\n\t\tborder-radius: 50%;\n\t\tbackground: #F3F4F6;\n\t\tborder: none;\n\t\tcursor: pointer;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tpadding: 0;\n\t}\n\t.ri-header-icon-btn i {\n\t\tfont-size: 18px;\n\t\tcolor: #6B7280;\n\t}\n&lt;/style&gt;\n\n&lt;div class=&quot;ri-header-bar&quot;&gt;\n\t&lt;span class=&quot;ri-header-breadcrumb&quot;&gt;Request Intake&lt;/span&gt;\n\t&lt;div class=&quot;ri-header-actions&quot;&gt;\n\t\t&lt;button class=&quot;ri-header-icon-btn&quot; title=&quot;Accessibility&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-eye&quot;&gt;&lt;/i&gt;\n\t\t&lt;/button&gt;\n\t\t&lt;button class=&quot;ri-header-icon-btn&quot; title=&quot;Notifications&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-bell-53&quot;&gt;&lt;/i&gt;\n\t\t&lt;/button&gt;\n\t\t&lt;button class=&quot;ri-header-icon-btn&quot; title=&quot;Profile&quot;&gt;\n\t\t\t&lt;i class=&quot;zc-li-outline ui-1-single-02&quot;&gt;&lt;/i&gt;\n\t\t&lt;/button&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t\t<dsp id='ri_form_card' elementName='Form_Card'>\n\t\t\t\t\t<![CDATA[htmlpage ri_form_card()\n\t\t\t\t\t\t content\n\t\t\t\t\t\t &lt;%{%&gt;\n\t\t\t\t\t\t\t\t &lt;link href=&apos;https://fonts.googleapis.com/css2?family=Lato:wght@400;700&amp;display=swap&apos; rel=&apos;stylesheet&apos;&gt;\n&lt;style&gt;\n\t.ri-content-area {\n\t\tmargin-left: 220px;\n\t\tbackground: #F8FAFC;\n\t\tmin-height: 100vh;\n\t\tpadding-top: 56px;\n\t\tbox-sizing: border-box;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n\t.ri-content-inner {\n\t\tpadding: 32px;\n\t}\n\t.ri-page-title {\n\t\tfont-size: 22px;\n\t\tfont-weight: 700;\n\t\tcolor: #111827;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tmargin: 0 0 4px 0;\n\t}\n\t.ri-page-subtitle {\n\t\tfont-size: 13px;\n\t\tcolor: #6B7280;\n\t\tmargin: 0 0 24px 0;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t}\n\t.ri-form-card {\n\t\tbackground: #FFFFFF;\n\t\tborder-radius: 12px;\n\t\tbox-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n\t\tpadding: 32px;\n\t\tmax-width: 900px;\n\t}\n\t.ri-info-strip {\n\t\tdisplay: flex;\n\t\talign-items: flex-start;\n\t\tgap: 8px;\n\t\tbackground: #F8FAFC;\n\t\tborder-radius: 6px;\n\t\tpadding: 10px 14px;\n\t\tmargin-bottom: 20px;\n\t}\n\t.ri-info-strip i {\n\t\tfont-size: 14px;\n\t\tcolor: #6B7280;\n\t\tmargin-top: 1px;\n\t\tflex-shrink: 0;\n\t}\n\t.ri-info-strip-text {\n\t\tfont-size: 12px;\n\t\tcolor: #6B7280;\n\t\tfont-style: italic;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tline-height: 1.5;\n\t}\n\t.ri-form-embed {\n\t\twidth: 100%;\n\t}\n\t.ri-tier-legend {\n\t\tmargin-top: 20px;\n\t\tborder-top: 1px solid #F3F4F6;\n\t\tpadding-top: 16px;\n\t}\n\t.ri-tier-legend-label {\n\t\tfont-size: 12px;\n\t\tcolor: #6B7280;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tmargin-bottom: 8px;\n\t\tdisplay: block;\n\t}\n\t.ri-tier-badges {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tflex-wrap: wrap;\n\t}\n\t.ri-tier-badge {\n\t\tborder-radius: 20px;\n\t\tpadding: 4px 12px;\n\t\tfont-size: 12px;\n\t\tfont-family: &apos;Lato&apos;, sans-serif;\n\t\tfont-weight: 400;\n\t\tdisplay: inline-block;\n\t}\n\t.ri-tier-badge-auto {\n\t\tbackground: #DCFCE7;\n\t\tcolor: #16AD78;\n\t}\n\t.ri-tier-badge-two {\n\t\tbackground: #FEF9C3;\n\t\tcolor: #D97706;\n\t}\n\t.ri-tier-badge-three {\n\t\tbackground: #EFF6FF;\n\t\tcolor: #2563EB;\n\t}\n&lt;/style&gt;\n\n&lt;div class=&quot;ri-content-area&quot;&gt;\n\t&lt;div class=&quot;ri-content-inner&quot;&gt;\n\t\t&lt;h1 class=&quot;ri-page-title&quot;&gt;New Spend Request&lt;/h1&gt;\n\t\t&lt;p class=&quot;ri-page-subtitle&quot;&gt;Atlas Precision Manufacturing Inc. &amp;middot; Plant 3, Ohio, USA&lt;/p&gt;\n\n\t\t&lt;div class=&quot;ri-form-card&quot;&gt;\n\t\t\t&lt;div class=&quot;ri-info-strip&quot;&gt;\n\t\t\t\t&lt;i class=&quot;zc-li-outline ui-1-info-circle&quot;&gt;&lt;/i&gt;\n\t\t\t\t&lt;span class=&quot;ri-info-strip-text&quot;&gt;Requester ID, Reporting Manager, and Department Head are auto-resolved when your name and department match our employee records.&lt;/span&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ri-form-embed&quot;&gt;\n\t\t\t\t&lt;div zc-component=&quot;form&quot; zc-linkname=&quot;Spend_Request&quot; zc-height=&quot;auto&quot;&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;div class=&quot;ri-tier-legend&quot;&gt;\n\t\t\t\t&lt;span class=&quot;ri-tier-legend-label&quot;&gt;Approval Tier Thresholds&lt;/span&gt;\n\t\t\t\t&lt;div class=&quot;ri-tier-badges&quot;&gt;\n\t\t\t\t\t&lt;span class=&quot;ri-tier-badge ri-tier-badge-auto&quot;&gt;Auto &amp;mdash; Up to $1,000&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;ri-tier-badge ri-tier-badge-two&quot;&gt;2-Person &amp;mdash; $1,001 &amp;ndash; $50,000&lt;/span&gt;\n\t\t\t\t\t&lt;span class=&quot;ri-tier-badge ri-tier-badge-three&quot;&gt;3-Person &amp;mdash; $50,001+&lt;/span&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t\t\t\t &lt;%}%&gt;\n\t\t\t\t ]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Approval_Action_On_Success as "Update Request Status and Log Decision"
			{
			    type = form
			    form = Approval_Action
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Find the target Spend Request record
			                req_records = Spend_Request[Request_ID == input.Request_ID_Input];
			                for each req in req_records
			                {
			                    cost_val = req.Estimated_Cost;
			                    stage = input.Approver_Stage;
			                    decision = input.Decision;
			
			                    // Determine tier from cost
			                    if(cost_val <= 1000) { tier = "Auto"; }
			                    else if(cost_val <= 50000) { tier = "2-Person"; }
			                    else { tier = "3-Person"; }
			
			                    // Determine new status
			                    // Determine new status
			                    if(decision == "Approved")
			                    {
			                        if(stage == "Reporting Manager" && tier == "2-Person")
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                        else if(stage == "Reporting Manager" && tier == "3-Person")
			                        {
			                            new_status = "Pending_Dept_Head";
			                        }
			                        else if(stage == "Department Head")
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                        else if(stage == "Finance Controller")
			                        {
			                            new_status = "Approved";
			                        }
			                        else
			                        {
			                            new_status = "Pending_Finance";
			                        }
			                    }
			                    else if(decision == "On Hold")
			                    {
			                        new_status = "On_Hold";
			                    }
			                    else if(decision == "Rejected")
			                    {
			                        new_status = "Rejected";
			                    }
			                    else
			                    {
			                        new_status = "On_Hold";
			                    }
			
			                    // Update the Spend Request status
			                    update Spend_Request[ID == req.ID]
			                    [
			                        Status = new_status
			                    ];
			
			                    // Create Approval Log entry
			                    insert into Approval_Log
			                    [
			                        Request_ID_Ref = input.Request_ID_Input
			                        Stage = stage
			                        Approver_Name = input.Approver_Name
			                        Decision = decision
			                        Decision_Timestamp = zoho.currenttime
			                        Comments = input.Comments
			                    ];
			                    break;
			                }
			            )
			        }
			    }
			}

			Department_On_User_Input as "Filter Items and Resolve Manager on Department Change"
			{
			    type = form
			    form = Spend_Request
			    record event = on add or edit
			
			    on user input of Department
			    {
			        actions
			        {
			            custom deluge script
			            (
			                // Clear dependent fields
			                input.Item_Description = "";
			                input.Estimated_Cost = 0;
			
			                // Resolve employee details
			                emp_records = Employee_Directory[Employee_Name == input.Requester_Name && Department == input.Department];
			                for each emp in emp_records
			                {
			                    input.Requester_ID = emp.Requester_ID;
			                    input.Reporting_Manager_Name = emp.Reporting_Manager;
			                    input.Department_Head_Name = emp.Department_Head;
			                    break;
			                }
			            )
			        }
			    }
			}

			Item_Description_On_User_Input as "Auto-Populate Cost on Item Selection"
			{
			    type = form
			    form = Spend_Request
			    record event = on add or edit
			
			    on user input of Item_Description
			    {
			        actions
			        {
			            custom deluge script
			            (
			                catalog_records = Request_Catalog[Department == input.Department && Item_Description == input.Item_Description];
			                for each catalog_item in catalog_records
			                {
			                    input.Estimated_Cost = catalog_item.Catalog_Cost;
			                    break;
			                }
			            )
			        }
			    }
			}

			Requester_Name_On_User_Input as "Resolve Requester ID on Name Input"
			{
			    type = form
			    form = Spend_Request
			    record event = on add or edit
			
			    on user input of Requester_Name
			    {
			        actions
			        {
			            custom deluge script
			            (
			                emp_records = Employee_Directory[Employee_Name == input.Requester_Name && Department == input.Department];
			                for each emp in emp_records
			                {
			                    input.Requester_ID = emp.Requester_ID;
			                    input.Reporting_Manager_Name = emp.Reporting_Manager;
			                    input.Department_Head_Name = emp.Department_Head;
			                    break;
			                }
			            )
			        }
			    }
			}

			Spend_Request_On_Success as "Set Request ID and Route on Submit"
			{
			    type = form
			    form = Spend_Request
			    record event = on add
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                /* Skip auto-generation if Request_ID is already set (e.g. seeded records) */
			                if(input.Request_ID == null || input.Request_ID == "")
			                {
			                    current_year = zoho.currentdate.getYear();
			                    rec_id = input.ID;
			                    id_str = "" + rec_id;
			                    padded_id = id_str;
			                    if(id_str.length() == 1) { padded_id = "000" + id_str; }
			                    else if(id_str.length() == 2) { padded_id = "00" + id_str; }
			                    else if(id_str.length() == 3) { padded_id = "0" + id_str; }
			                    req_id = "BRQ-" + current_year + "-" + padded_id;
			                    sub_date = zoho.currentdate;
			
			                    cost_val = input.Estimated_Cost;
			                    if(cost_val <= 1000)
			                    {
			                        new_status = "Auto_Approved";
			                        sla_date = zoho.currentdate;
			                    }
			                    else
			                    {
			                        new_status = "Pending_RM";
			                        sla_date = zoho.currentdate.addDay(60);
			                    }
			
			                    update Spend_Request[ID == input.ID]
			                    [
			                        Request_ID = req_id
			                        Submitted_Date = sub_date
			                        Status = new_status
			                        SLA_Due_Date = sla_date
			                    ];
			
			                    if(cost_val <= 1000)
			                    {
			                        insert into Approval_Log
			                        [
			                            Request_ID_Ref = req_id
			                            Stage = "System"
			                            Approver_Name = "System"
			                            Decision = "Auto-Approved"
			                            Decision_Timestamp = zoho.currenttime
			                            Comments = "Auto-approved based on amount threshold (up to $1,000)"
			                        ];
			                    }
			                    else
			                    {
			                        insert into Approval_Log
			                        [
			                            Request_ID_Ref = req_id
			                            Stage = "System"
			                            Approver_Name = input.Requester_Name
			                            Decision = "Submitted"
			                            Decision_Timestamp = zoho.currenttime
			                            Comments = "Request submitted by " + input.Requester_Name + " from " + input.Department
			                        ];
			                    }
			                }
			            )
			        }
			    }
			}
		}

